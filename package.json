{
  "name": "1oak-financial-group",
  "version": "1.0.0",
  "private": true,
  "description": "Website for 1Oak Financial Group, Monrovia, CA",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/ensure-images.ts && tsx scripts/prelaunch-check.ts",
    "build": "next build",
    "postbuild": "node scripts/postbuild-check.mjs",
    "build:static": "tsx scripts/prelaunch-check.ts && node scripts/build-static.mjs && node scripts/postbuild-check.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:content": "tsx scripts/content-audit.ts",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "images": "tsx scripts/process-images.ts",
    "brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "framer-motion": "13.4.6",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
