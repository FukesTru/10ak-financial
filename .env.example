# Copy to .env.local for development, or set these in your hosting provider.

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX). Leave blank to disable GA4.
NEXT_PUBLIC_GA4_ID=

# --- Lead delivery (configure at least one channel in production) ---
# Email via Resend (https://resend.com). Sender must be on a verified domain.
EMAIL_PROVIDER_KEY=
LEAD_EMAIL_FROM="1Oak Website <leads@1oak-financial.com>"
LEAD_EMAIL_TO=info@1oakfg.com

# SMS via Twilio. Lead texts go to LEAD_SMS_TO.
SMS_PROVIDER_KEY=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=
LEAD_SMS_TO=+18182452329

# Optional CRM webhook (GoHighLevel, Zapier, etc.) — receives each lead as JSON.
CRM_WEBHOOK_URL=

# Static export only: where the lead form posts when /api/lead isn't available.
NEXT_PUBLIC_LEAD_ENDPOINT=
